    "kit.glassRule": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На iOS 26+ Liquid Glass применяется к навигации и действиям. Контент и поля используют системные поверхности. На более ранних версиях — стандартные стили кнопок."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On iOS 26+, Liquid Glass is used for navigation and actions. Content and fields use system surfaces. Earlier versions use standard button styles."
          }
        }
      }
    },
