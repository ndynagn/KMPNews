    "kit.actionsRule": {
      "extractionState": "manual",
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно основное действие на шаг. Вторичные действия не конкурируют с ним. Во время запроса повторное нажатие недоступно."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One primary action per step. Secondary actions do not compete with it. Repeated submission is disabled while loading."
          }
        }
      }
    },
