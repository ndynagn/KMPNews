root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{kt,kts}]
max_line_length = 120
ktlint_code_style = intellij_idea
ij_kotlin_code_style_defaults = KOTLIN_OFFICIAL
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# An empty list also prevents ktlint's intellij_idea preset from allowing java.util.*.
ij_kotlin_packages_to_use_import_on_demand =
ij_kotlin_name_count_to_use_star_import = 2147483647
ij_kotlin_name_count_to_use_star_import_for_members = 2147483647
ij_kotlin_imports_layout = *
ktlint_function_naming_ignore_when_annotated_with = Composable

# Toolchain's existing Desktop entrypoint is intentionally lower-case.
[desktopApp/src/main.kt]
ktlint_standard_filename = disabled

# Generated and third-party trees are not handwritten style inputs, including in the IDE.
[**/{build,generated,vendor,third-party,.git,.idea,.gradle,.kotlin,.toolchain,.agents,.skills,node_modules,Pods,Carthage,.build,DerivedData,SourcePackages}/**/*.{kt,kts}]
ktlint = disabled

[*.swift]
max_line_length = 120

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.{json,yml,yaml}]
indent_size = 2

[project.pbxproj]
# Preserve Xcode's serialization; this file is excluded from formatters.
indent_style = tab
indent_size = 4
